{
	"compilerOptions": {
		"target": "esnext",
		"module": "nodenext",
		"allowJs": true,
		"outDir": "dist",
		"moduleResolution": "nodenext",
		"sourceRoot": "src",
		"rootDir": "src",
		"sourceMap": true,
		"allowSyntheticDefaultImports": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"resolveJsonModule": true,
		"strict": false,
		"strictNullChecks": false,
		"noImplicitAny": false,
		"paths": {
			"#classes/*": ["./src/classes/*"],
			"#handlers/*": ["./src/classes/Handlers/*"],
			"#functions/*": ["./src/functions/*"],
			"#utils/*": ["./src/utils/*"],
			"#client": ["./src/classes/Ryneczek.ts"],
			"#types/": ["./src/types/*"],
			"#prisma": ["./prisma/generated/prisma/client"],
			"#agents/*": ["./src/agents/*"]
		}
	},
	"include": ["src/**/*"],
	"exclude": ["prisma/generated", "config.json"]
}

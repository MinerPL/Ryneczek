{
	"name": "ryneczek",
	"version": "1.0.0",
	"main": "dist",
	"type": "module",
	"author": "Dawid Jaworski <contact@minerpl.xyz>",
	"license": "MIT",
	"scripts": {
		"dev": "npm run build && npm start",
		"build": "rm -rf dist/ && tsc",
		"start": "npm run migrate:deploy && node --enable-source-maps .",
		"migrate:reset": "prisma migrate reset",
		"migrate:create": "prisma migrate dev --create-only",
		"migrate:dev": "prisma migrate dev",
		"migrate:deploy": "prisma migrate deploy",
		"prisma:generate": "prisma generate"
	},
	"imports": {
		"#classes/*": "./dist/classes/*.js",
		"#handlers/*": "./dist/classes/Handlers/*.js",
		"#functions/*": "./dist/functions/*.js",
		"#utils/*": "./dist/utils/*.js",
		"#client": "./dist/classes/Ryneczek.js",
		"#prisma": "./prisma/generated/prisma/client.js",
		"#types/*": "./dist/types/*.js",
		"#agents/*": "./dist/agents/*.js"
	},
	"dependencies": {
		"@prisma/adapter-better-sqlite3": "^7.9.1",
		"@prisma/client": "^7.9.1",
		"@sentry/node": "^10.69.0",
		"discord-api-types": "^0.38.53",
		"discord-html-transcripts": "^3.3.0",
		"discord.js": "^14.27.0",
		"imapflow": "^1.6.6",
		"mailparser": "^3.9.15",
		"undici": "^8.10.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.7",
		"@types/mailparser": "^3.4.6",
		"prisma": "^7.9.1",
		"typescript": "^7.0.2"
	}
}
